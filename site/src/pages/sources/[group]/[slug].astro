---
import { getCollection, render } from 'astro:content';
import { getSourceGroups, usesLetterTableStyle } from '../../../lib/sources';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SourcePanel from '../../../components/SourcePanel.astro';
import CopyArticleButton from '../../../components/CopyArticleButton.astro';
import { toExcerpt } from '../../../lib/excerpt';
import { absoluteUrl, canonicalPath, ogKey, articleLd, breadcrumbLd } from '../../../lib/seo';

export async function getStaticPaths() {
  const groups = await getSourceGroups();
  const collection = await getCollection('sources');
  const paths = [];
  for (const g of groups) {
    for (const s of g.sources) {
      const entry = collection.find((c: any) => c.data.slug === s.slug && c.data.category === s.category);
      // 面包屑用:该原文分组的入口(组内首篇)URL。
      paths.push({
        params: { group: g.groupSlug, slug: s.slug },
        props: { source: s, entry, groupName: g.name, groupFirstUrl: g.sources[0]?.url ?? s.url },
      });
    }
  }
  return paths;
}

const { source, entry, groupName, groupFirstUrl } = Astro.props;
const hasLetterTables = usesLetterTableStyle(source.category);
const { Content } = await render(entry);

// 原文已在 frontmatter 手写 SEO 文案(全 284 篇齐备),优先用;缺时回退正文摘要。
const seoTitle = entry.data.seoTitle as string | undefined;
const description =
  (entry.data.seoDescription as string | undefined) ??
  (entry.data.description as string | undefined) ??
  toExcerpt(source.body, 150);

const site = Astro.site ?? new URL('https://buffett.ayaseeri.com');
const url = absoluteUrl(site, canonicalPath(Astro.url.pathname));
const image = absoluteUrl(site, `/og/${ogKey(Astro.url.pathname)}.png`);
const jsonLd = [
  articleLd({ url, title: source.title, description, section: source.category, image }),
  breadcrumbLd([
    { name: '首页', url: absoluteUrl(site, '/') },
    { name: groupName, url: absoluteUrl(site, groupFirstUrl) },
    { name: source.title, url },
  ]),
];
---
<BaseLayout
  title={source.title}
  seoTitle={seoTitle}
  description={description}
  ogType="article"
  jsonLd={jsonLd}
>
  <div class="article-tools">
    <CopyArticleButton targetId="article-content" />
  </div>
  <article id="article-content" class:list={{ 'letter-tables': hasLetterTables }} data-pagefind-body>
    <h1>{source.title}</h1>
    <p style="color:var(--text-muted)">{source.category}</p>
    <Content />
  </article>
  <SourcePanel slot="aside" slug={source.slug} category={source.category} order={source.order} />
</BaseLayout>

<style is:global>
  .article-tools {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 1rem;
  }

  .letter-tables .letter-table-scroll {
    width: 100%;
    max-width: 100%;
    margin: 1.5rem 0 2rem;
    overflow-x: auto;
    border: 1px solid #d9d2c4;
    background: var(--panel);
  }

  .letter-tables .letter-table-scroll table {
    display: table;
    width: 100%;
    min-width: 100%;
    max-width: none;
    margin: 0;
    overflow: visible;
    border: 0;
    border-collapse: separate;
    border-spacing: 0;
    background: var(--panel);
    font-variant-numeric: tabular-nums lining-nums;
  }

  .letter-tables .letter-table-scroll th,
  .letter-tables .letter-table-scroll td {
    min-width: 6rem;
    padding: 0.7rem 0.8rem;
    text-align: left;
    vertical-align: middle;
  }

  .letter-tables .letter-table-scroll th {
    border-bottom: 2px solid var(--accent);
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 700;
    line-height: 1.55;
  }

  .letter-tables .letter-table-scroll .letter-table-numeric {
    text-align: right;
  }

  .letter-tables .letter-table-scroll th:first-child,
  .letter-tables .letter-table-scroll td:first-child {
    min-width: 5rem;
    text-align: left;
  }

  .letter-tables .letter-table-scroll tbody td {
    border-bottom: 1px solid #e7e1d4;
  }

  .letter-tables .letter-table-scroll tbody tr:last-child td {
    border-bottom: 0;
  }

  @media (hover: hover) {
    .letter-tables .letter-table-scroll tbody tr:hover td {
      background: #fbf4f2;
    }
  }

  @media (max-width: 767px) {
    .letter-tables .letter-table-scroll th,
    .letter-tables .letter-table-scroll td {
      min-width: 5.5rem;
      padding: 0.55rem 0.65rem;
    }

    .letter-tables .letter-table-scroll th:first-child,
    .letter-tables .letter-table-scroll td:first-child {
      min-width: 4.5rem;
    }
  }
</style>
