---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCategories } from '../lib/articles';
import { getSourceGroups } from '../lib/sources';
import { SITE, websiteLd } from '../lib/seo';

const categories = await getCategories();
const sourceGroups = await getSourceGroups();
const sourceTotal = sourceGroups.reduce((n, g) => n + g.sources.length, 0);

// 首页 SEO:完整标题、含篇数的描述、WebSite + 站内搜索结构化数据。
const siteUrl = (Astro.site ?? new URL('https://buffett.ayaseeri.com')).href;
const homeTitle = `${SITE.name}｜巴菲特致股东信、访谈与主题解读`;
const homeDesc = `先原文，后观点。汇集 ${sourceTotal} 篇巴菲特原文(致股东信、致合伙人信、访谈与股东大会)与 ${categories.length} 个主题解读，每条解读都标注原文出处，用原文校准判断。`;

// 巴菲特名言（首页总纲）：两条规则各占一行，不加引号。
const rules = ['第一条规则：永远不要亏损', '第二条规则：永远记住第一条'];

// 原文分组的「单字徽标 + 一句话简介」。键即原文分类中文名（与 SOURCE_GROUP_SLUG 一致）。
const SOURCE_CARD: Record<string, { char: string; desc: string }> = {
  '访谈与文章': { char: '访', desc: '历年访谈、演讲与文章实录' },
  '致股东信': { char: '信', desc: '伯克希尔历年致股东的信' },
  '致合伙人信': { char: '伙', desc: '早期合伙公司时期的信件' },
  '股东大会': { char: '会', desc: '股东大会现场问答记录' },
};

// 解读分类的「单字徽标 + 一句话简介」。键即分类中文名（与 CATEGORY_SLUG 一致），
// 简介取自该分类总论标题冒号后的主旨，单字徽标点题——呼应总纲的字块版式。
const CARD: Record<string, { char: string; desc: string }> = {
  '核心哲学': { char: '道', desc: '长期、理性与不犯大错' },
  '投资理念': { char: '投', desc: '从价值投资到资本配置' },
  '企业经营': { char: '商', desc: '文化、经理人与股东利益' },
  '财务指标': { char: '数', desc: '从账面价值到真实收益' },
  '品格与心性': { char: '心', desc: '诚信、理性与改正错误' },
  '公司': { char: '司', desc: '伯克希尔如何理解一家公司' },
  '行业': { char: '业', desc: '银行、报纸、公用事业、铁路与能源' },
  '人物': { char: '人', desc: '导师、合伙人、经理人与接班人' },
  '保险、浮存金与风险': { char: '险', desc: '浮存金、承保纪律与巨灾风险' },
  '市场周期与风险控制': { char: '市', desc: '波动、泡沫与风险控制' },
  '宏观经济与投资环境': { char: '宏', desc: '利率、通胀、美元与美国经济' },
  '分类总论': { char: '纲', desc: '十二篇主题总论，从这里通览全局' },
  '问题': { char: '问', desc: '投资者关心的高频问题与解答' },
  '时间线': { char: '史', desc: '伯克希尔与巴菲特的关键年表' },
};
// 未登记项的兜底：取名字首字做徽标，简介留空，版式不塌。
const metaFor = (map: Record<string, { char: string; desc: string }>, name: string) =>
  map[name] ?? { char: [...name][0], desc: '' };
---
<BaseLayout title="首页" seoTitle={homeTitle} description={homeDesc} jsonLd={websiteLd(siteUrl)}>
  <section class="home">
    <header class="hero">
      <hr class="hero-rule" />
      <h1 class="hero-title">巴菲特总纲</h1>
      <hr class="hero-rule" />
      <p class="hero-quote">{rules.map((r) => <span class="quote-line">{r}</span>)}</p>

      <a class="author-card" href="https://xueqiu.com/u/lovelive" target="_blank" rel="noopener noreferrer">
        <span class="ac-text">
          <span class="ac-title">作者：滚雪球的Star</span>
          <span class="ac-sub">xueqiu.com/u/lovelive</span>
        </span>
        <span class="ac-arrow" aria-hidden="true">›</span>
      </a>
    </header>

    <section class="col-block">
      <h2 class="kicker">原文 · {sourceTotal} 篇</h2>
      <p class="lead">先原文，后观点；先证据，后文章。一切回到巴菲特自己的话。</p>
      <ul class="cat-grid">
        {sourceGroups.map((g) => {
          const m = metaFor(SOURCE_CARD, g.name);
          const href = g.sources[0]?.url ?? '#';
          return (
            <li>
              <a class="cat-card" href={href}>
                <span class="cat-badge" aria-hidden="true">{m.char}</span>
                <span class="cat-body">
                  <span class="cat-top">
                    <span class="cat-name">{g.name}</span>
                    <span class="cat-count">{g.sources.length} 篇</span>
                  </span>
                  {m.desc && <span class="cat-desc">{m.desc}</span>}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    <section class="col-block">
      <h2 class="kicker">解读 · {categories.length} 个分类</h2>
      <p class="lead">围绕主题整理的解读文章，每条都标注原文出处。</p>
      <ul class="cat-grid">
        {categories.map((c) => {
          const m = metaFor(CARD, c.name);
          return (
            <li>
              <a class="cat-card" href={`/categories/${c.slug}`}>
                <span class="cat-badge" aria-hidden="true">{m.char}</span>
                <span class="cat-body">
                  <span class="cat-top">
                    <span class="cat-name">{c.name}</span>
                    <span class="cat-count">{c.articles.length} 篇</span>
                  </span>
                  {m.desc && <span class="cat-desc">{m.desc}</span>}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    <footer class="site-footer">
      <a href="https://beian.miit.gov.cn" target="_blank" rel="noopener noreferrer">浙ICP备17053536号-2</a>
    </footer>
  </section>
</BaseLayout>

<style>
  .home { padding-bottom: 1rem; }

  /* 总纲：上下短绿线 → 大字标题 → 灰色名言 → 作者卡片。配色沿用站点绿，结构照参考版式。 */
  .hero { text-align: center; padding: 1.5rem 0 0.5rem; }
  .hero-rule {
    width: 110px; height: 3px; border: 0; margin: 0 auto;
    background: var(--green);
  }
  .hero-title {
    color: var(--text); font-weight: 700;
    font-size: clamp(2.1rem, 7vw, 3.2rem);
    letter-spacing: 0.32em; padding-left: 0.32em; /* 抵消末字后的字距，使字块视觉居中 */
    margin: 1.5rem 0;
  }
  /* 名言块整体居中，块内左对齐——两行行首对齐。加粗 + 警示红，强调“永不亏损”。 */
  .hero-quote {
    width: fit-content;
    color: var(--danger); font-weight: 700;
    font-size: clamp(1.05rem, 2.6vw, 1.35rem);
    line-height: 2; margin: 1.6rem auto 0;
    text-align: left;
  }
  .quote-line { display: block; }

  /* 作者卡片：白底、细边、微投影，悬停轻微抬起。 */
  .author-card {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    max-width: 460px; margin: 2.2rem auto 0;
    background: var(--panel); border: 1px solid #e7e1d4; border-radius: 10px;
    padding: 0.95rem 1.2rem; text-align: left;
    box-shadow: 0 8px 24px rgba(55, 47, 34, 0.06);
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }
  .author-card:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(55, 47, 34, 0.12); text-decoration: none; }
  .ac-text { display: flex; flex-direction: column; min-width: 0; }
  .ac-title { color: var(--text); font-weight: 700; font-size: 1.05rem; }
  .ac-sub {
    color: var(--text-muted); font-size: 0.82rem; margin-top: 0.15rem;
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  .ac-arrow { color: var(--text-muted); font-size: 1.4rem; line-height: 1; flex: none; }

  /* 栏目区块标题。 */
  .col-block { margin-top: 3.2rem; }
  .kicker {
    color: var(--green); font-weight: 700; font-size: 0.8rem; letter-spacing: 0.12em;
    margin: 0; font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  .col-block .lead { color: var(--text-muted); font-size: 0.95rem; margin: 0.4rem 0 0; }

  /* 卡片网格：两列，移动端单列。原文与解读共用。 */
  .cat-grid {
    list-style: none; padding: 0; margin: 1.2rem 0 0;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem;
  }
  .cat-card {
    display: flex; gap: 0.85rem; align-items: flex-start; height: 100%;
    background: var(--panel); border: 1px solid #e7e1d4; border-radius: 10px; padding: 1rem;
    transition: box-shadow 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
  }
  .cat-card:hover {
    transform: translateY(-2px); border-color: var(--green);
    box-shadow: 0 10px 26px rgba(55, 47, 34, 0.10); text-decoration: none;
  }
  .cat-badge {
    flex: none; width: 46px; height: 46px; display: grid; place-items: center;
    background: var(--green-soft); color: var(--green); border-radius: 8px;
    font-size: 1.4rem; font-weight: 700;
  }
  .cat-body { flex: 1; min-width: 0; }
  .cat-top { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; }
  .cat-name { color: var(--text); font-weight: 700; font-size: 1.05rem; }
  .cat-count {
    flex: none; color: var(--green); font-size: 0.82rem;
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  .cat-desc {
    color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; margin-top: 0.3rem;
    display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2;
    -webkit-box-orient: vertical; overflow: hidden;
  }

  .author-card:focus-visible, .cat-card:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }

  /* 底部备案号。 */
  .site-footer {
    margin-top: 3.5rem; padding-top: 1.4rem; border-top: 1px solid #e7e1d4;
    text-align: center; font-size: 0.8rem;
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  .site-footer a { color: var(--text-muted); }
  .site-footer a:hover { color: var(--green); }

  @media (max-width: 560px) {
    .cat-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .author-card, .cat-card { transition: none; }
    .author-card:hover, .cat-card:hover { transform: none; }
  }
</style>
