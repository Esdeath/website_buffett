---
// 主题切换器:浅色 / 墨黑 / 护眼绿。配色与交互沿用 website_duan 的 ThemePicker。
// 页面内可放多个实例(顶栏 + 侧栏),脚本只打包一次,统一驱动并保持同步。
interface Props {
  placement?: 'bottom-start' | 'bottom-end' | 'top-start' | 'top-end';
}
const { placement = 'bottom-start' } = Astro.props as Props;
const options = [
  { value: 'light', label: '浅色', color: '#f8f5f0' },
  { value: 'dark', label: '墨黑', color: '#1a1a1a' },
  { value: 'green', label: '护眼绿', color: '#c0edc6' },
];
---
<div class="theme-picker" data-placement={placement}>
  <button
    class="theme-trigger"
    type="button"
    aria-label="选择主题"
    aria-haspopup="menu"
    aria-expanded="false"
    title="选择主题"
  >
    <span class="theme-trigger-swatch" style="background:#f8f5f0" aria-hidden="true"></span>
    <svg class="theme-trigger-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m6 9 6 6 6-6" />
    </svg>
  </button>
  <div class="theme-menu" role="menu" aria-label="选择主题">
    {options.map((o) => (
      <button
        class="theme-option"
        type="button"
        role="menuitemradio"
        aria-checked="false"
        data-theme-value={o.value}
      >
        <span class="theme-option-swatch" style={`background:${o.color}`} aria-hidden="true"></span>
        <span>{o.label}</span>
        <svg class="theme-option-check" width="15" height="15" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m20 6-11 11-5-5" />
        </svg>
      </button>
    ))}
  </div>
</div>

<script>
  type Theme = 'light' | 'dark' | 'green';
  const META: Record<Theme, { label: string; color: string }> = {
    light: { label: '浅色', color: '#f8f5f0' },
    dark: { label: '墨黑', color: '#1a1a1a' },
    green: { label: '护眼绿', color: '#c0edc6' },
  };

  const current = (): Theme => {
    const c = document.documentElement.classList;
    return c.contains('dark') ? 'dark' : c.contains('green') ? 'green' : 'light';
  };

  const apply = (t: Theme) => {
    const d = document.documentElement;
    d.classList.remove('dark', 'green');
    if (t !== 'light') d.classList.add(t);
    try { localStorage.setItem('theme', t); } catch { /* 存储不可用也不影响当前页生效 */ }
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', META[t].color);
    window.dispatchEvent(new CustomEvent('themechange', { detail: t }));
  };

  const pickers = Array.from(document.querySelectorAll<HTMLElement>('.theme-picker'));

  const sync = () => {
    const t = current();
    for (const p of pickers) {
      const swatch = p.querySelector<HTMLElement>('.theme-trigger-swatch');
      if (swatch) swatch.style.background = META[t].color;
      const trigger = p.querySelector<HTMLElement>('.theme-trigger');
      trigger?.setAttribute('aria-label', `选择主题,当前:${META[t].label}`);
      trigger?.setAttribute('title', `选择主题,当前:${META[t].label}`);
      p.querySelectorAll<HTMLElement>('.theme-option').forEach((o) => {
        const on = o.dataset.themeValue === t;
        o.classList.toggle('active', on);
        o.setAttribute('aria-checked', String(on));
      });
    }
  };

  const closeAll = (except?: HTMLElement) => {
    for (const p of pickers) {
      if (p === except) continue;
      if (!p.classList.contains('open')) continue;
      p.classList.remove('open');
      p.querySelector('.theme-trigger')?.setAttribute('aria-expanded', 'false');
    }
  };

  for (const p of pickers) {
    const trigger = p.querySelector<HTMLButtonElement>('.theme-trigger')!;
    const options = Array.from(p.querySelectorAll<HTMLButtonElement>('.theme-option'));

    const setOpen = (open: boolean) => {
      p.classList.toggle('open', open);
      trigger.setAttribute('aria-expanded', String(open));
    };
    const close = (restore = false) => { setOpen(false); if (restore) trigger.focus(); };
    const open = () => {
      closeAll(p);
      setOpen(true);
      const i = options.findIndex((o) => o.dataset.themeValue === current());
      options[Math.max(i, 0)]?.focus();
    };

    trigger.addEventListener('click', () => (p.classList.contains('open') ? close() : open()));

    options.forEach((o, idx) => {
      o.addEventListener('click', () => { apply(o.dataset.themeValue as Theme); sync(); close(true); });
      o.addEventListener('keydown', (e) => {
        let ni = idx;
        if (e.key === 'ArrowDown') ni = (idx + 1) % options.length;
        else if (e.key === 'ArrowUp') ni = (idx - 1 + options.length) % options.length;
        else if (e.key === 'Home') ni = 0;
        else if (e.key === 'End') ni = options.length - 1;
        else if (e.key === 'Escape') { e.preventDefault(); close(true); return; }
        else if (e.key === 'Tab') { close(); return; }
        else return;
        e.preventDefault();
        options[ni].focus();
      });
    });

    p.addEventListener('focusout', (e) => {
      const next = e.relatedTarget;
      if (p.classList.contains('open') && (!(next instanceof Node) || !p.contains(next))) close();
    });
  }

  document.addEventListener('pointerdown', (e) => {
    for (const p of pickers) {
      if (p.classList.contains('open') && !p.contains(e.target as Node)) {
        p.classList.remove('open');
        p.querySelector('.theme-trigger')?.setAttribute('aria-expanded', 'false');
      }
    }
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });

  window.addEventListener('themechange', sync);
  sync();
</script>

<style>
  .theme-picker { position: relative; display: inline-flex; }

  .theme-trigger {
    display: grid;
    grid-template-columns: 18px 12px;
    place-items: center;
    gap: 2px;
    width: 40px;
    height: 40px;
    padding: 0 4px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--panel);
    color: var(--text-muted);
    cursor: pointer;
  }
  .theme-trigger:hover,
  .theme-trigger[aria-expanded='true'] {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--text);
  }
  .theme-trigger:focus-visible,
  .theme-option:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .theme-trigger-swatch,
  .theme-option-swatch {
    display: block;
    border: 1px solid color-mix(in srgb, currentColor 30%, transparent);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22);
  }
  .theme-trigger-swatch { width: 16px; height: 16px; border-radius: 50%; }
  .theme-option-swatch { width: 18px; height: 18px; border-radius: 4px; }

  .theme-trigger-chevron { transition: transform 0.2s var(--ease-out); }
  .theme-picker.open .theme-trigger-chevron { transform: rotate(180deg); }

  .theme-menu {
    position: absolute;
    z-index: 80;
    width: 172px;
    padding: 6px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--panel);
    color: var(--text);
    box-shadow: 0 12px 30px rgba(24, 28, 24, 0.18);
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition: opacity 0.16s var(--ease-out), transform 0.16s var(--ease-out), visibility 0.16s var(--ease-out);
  }
  .theme-picker.open .theme-menu { opacity: 1; visibility: visible; transform: none; }

  .theme-picker[data-placement='bottom-start'] .theme-menu { top: calc(100% + 8px); left: 0; }
  .theme-picker[data-placement='bottom-end'] .theme-menu { top: calc(100% + 8px); right: 0; }
  .theme-picker[data-placement='top-start'] .theme-menu { bottom: calc(100% + 8px); left: 0; }
  .theme-picker[data-placement='top-end'] .theme-menu { bottom: calc(100% + 8px); right: 0; }
  .theme-picker[data-placement^='top'] .theme-menu { transform: translateY(-4px); }
  .theme-picker[data-placement^='top'].open .theme-menu { transform: none; }

  .theme-option {
    display: grid;
    grid-template-columns: 20px 1fr 18px;
    align-items: center;
    gap: 10px;
    width: 100%;
    min-height: 40px;
    padding: 7px 9px;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--text-muted);
    font-family: inherit;
    font-size: 13px;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
  }
  .theme-option:hover,
  .theme-option:focus-visible {
    background: var(--accent-soft);
    color: var(--text);
  }
  .theme-option.active { color: var(--accent); font-weight: 700; }
  .theme-option-check { justify-self: end; visibility: hidden; }
  .theme-option.active .theme-option-check { visibility: visible; }

  @media (prefers-reduced-motion: reduce) {
    .theme-trigger-chevron,
    .theme-menu { transition: none; }
  }
</style>
