---
import { getCategories } from '../lib/articles';
import { getSourceGroups } from '../lib/sources';
const categories = await getCategories();
const sourceGroups = await getSourceGroups();
// 二级标签 = 冒号前关键词;无冒号(如公司名/原文标题)时 split 返回原标题,整条原样显示。
const label = (title: string) => title.split(/[：:]/)[0];
// 去尾斜杠后比较当前路径与文章 URL,标记「当前所在文章」(SSR 初判,客户端再校准)。
const norm = (p: string) => p.replace(/\/+$/, '') || '/';
const here = norm(Astro.url.pathname);
const isCurrent = (url: string) => norm(url) === here;
// 当前文章所在分类默认展开(解读 + 原文 都查)。
const currentCat = categories.find((c) => c.articles.some((a) => isCurrent(a.url)))?.slug;
const currentSrc = sourceGroups.find((g) => g.sources.some((s) => isCurrent(s.url)))?.groupSlug;
---
<nav class="panel">
  <a href="/"><strong>巴菲特知识库</strong></a>
  <p style="color: var(--text-muted); font-size: 0.85rem;">慢慢读，反复看，用原文校准判断。</p>
  <form action="/search" method="get" role="search">
    <input type="search" name="q" placeholder="搜索关键词、文章…" style="width:100%;padding:0.4rem;" />
  </form>
  <p class="menu-head">原文</p>
  <ul class="cat-menu">
    {sourceGroups.map((g) => (
      <li>
        <details data-cat={`src:${g.groupSlug}`} open={g.groupSlug === currentSrc}>
          <summary>{g.name}<span class="count"> · {g.sources.length}</span></summary>
          <div class="sub">
            {g.sources.map((s) => (
              <a
                href={s.url}
                title={s.title}
                class={isCurrent(s.url) ? 'active' : undefined}
                aria-current={isCurrent(s.url) ? 'page' : undefined}
              >{s.title}</a>
            ))}
          </div>
        </details>
      </li>
    ))}
  </ul>
  <p class="menu-head">解读</p>
  <ul class="cat-menu">
    {categories.map((c) => (
      <li>
        <details data-cat={c.slug} open={c.slug === currentCat}>
          <summary>{c.name}<span class="count"> · {c.articles.length}</span></summary>
          <div class="sub">
            {c.articles.map((a) => (
              <a
                href={a.url}
                title={a.title}
                class={isCurrent(a.url) ? 'active' : undefined}
                aria-current={isCurrent(a.url) ? 'page' : undefined}
              >{label(a.title)}</a>
            ))}
          </div>
        </details>
      </li>
    ))}
  </ul>
  <p style="margin-top:1rem;"><a href="/graph">查看知识图谱 →</a></p>
</nav>

<script>
  // 跨页面记住哪些分类是展开的:点二级链接跳转到文章后,该一级分类仍保持打开。
  const KEY = 'sidebar-open-cats';
  const read = (): Set<string> => {
    try { return new Set(JSON.parse(sessionStorage.getItem(KEY) ?? '[]')); }
    catch { return new Set(); }
  };
  const open = read();
  document.querySelectorAll<HTMLDetailsElement>('.cat-menu details[data-cat]').forEach((d) => {
    const slug = d.dataset.cat!;
    if (open.has(slug)) d.open = true; // 恢复上次状态
    d.addEventListener('toggle', () => {
      const set = read();
      d.open ? set.add(slug) : set.delete(slug);
      sessionStorage.setItem(KEY, JSON.stringify([...set]));
    });
  });

  // 客户端校准「当前文章」高亮:静态页路径可能带尾斜杠,与 href 不完全一致,
  // 这里按规范化路径重新匹配,并展开其所在分类。
  const norm = (p: string) => p.replace(/\/+$/, '') || '/';
  const hereNow = norm(location.pathname);
  document.querySelectorAll<HTMLAnchorElement>('.cat-menu .sub a').forEach((a) => {
    const match = norm(new URL(a.href).pathname) === hereNow;
    a.classList.toggle('active', match);
    if (match) {
      a.setAttribute('aria-current', 'page');
      a.closest('details')?.setAttribute('open', '');
    }
  });

  // 跨页面保持侧栏滚动位置:点二级链接跳转(整页刷新)后,侧栏停在原处而非回到顶部。
  // 放在展开分类/校准高亮之后,此时内容高度已定,恢复的 scrollTop 不会被裁剪。
  const SCROLL_KEY = 'sidebar-scroll';
  const scroller = document.querySelector<HTMLElement>('.col-left');
  if (scroller) {
    const saved = sessionStorage.getItem(SCROLL_KEY);
    if (saved) scroller.scrollTop = parseInt(saved, 10);
    scroller.addEventListener('scroll', () => {
      sessionStorage.setItem(SCROLL_KEY, String(scroller.scrollTop));
    }, { passive: true });
  }
</script>

<style>
  .menu-head {
    margin: 1.2rem 0 0.3rem; font-size: 0.78rem; font-weight: 700;
    letter-spacing: 0.08em; color: var(--text-muted);
    text-transform: none; border-bottom: 1px solid #e7e1d4; padding-bottom: 0.3rem;
  }
  .cat-menu { list-style: none; padding: 0; margin: 0.3rem 0 0; }
  .cat-menu > li { margin-bottom: 0.15rem; }
  .cat-menu summary {
    list-style: none; cursor: pointer; padding: 0.25rem 0;
    color: var(--green); font-weight: 600;
  }
  .cat-menu summary::-webkit-details-marker { display: none; }
  .cat-menu summary::before {
    content: "›"; display: inline-block; width: 1em;
    color: var(--text-muted); transition: transform 0.15s; transform-origin: 35% 50%;
  }
  .cat-menu details[open] > summary::before { transform: rotate(90deg); }
  .cat-menu summary:hover { text-decoration: underline; }
  .cat-menu .count { color: var(--text-muted); font-weight: 400; }
  .sub { display: flex; flex-direction: column; padding: 0.15rem 0 0.4rem 0; }
  .sub a {
    display: block; font-size: 0.9rem; color: var(--text);
    padding: 0.3rem 0.6rem 0.3rem 1.4rem; margin: 0 -0.2rem;
    border-left: 3px solid transparent; border-radius: 4px;
    transition: background 0.12s, color 0.12s;
  }
  .sub a:hover { background: var(--green-soft); color: var(--green); text-decoration: none; }
  .sub a.active {
    background: var(--green-soft); color: var(--green); font-weight: 600;
    border-left-color: var(--green);
  }
</style>
