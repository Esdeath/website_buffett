---
import BaseLayout from './BaseLayout.astro';
import KeywordPanel from '../components/KeywordPanel.astro';
import Backlinks from '../components/Backlinks.astro';
import SourceMatrix from '../components/SourceMatrix.astro';
import GraphView from '../components/GraphView.astro';
import { CATEGORY_SLUG } from '../lib/articles';
import { toExcerpt } from '../lib/excerpt';
import { absoluteUrl, canonicalPath, ogKey, articleLd, breadcrumbLd } from '../lib/seo';
const { article, Content } = Astro.props;

// 解读/关键词文章 SEO:正文摘要作描述,Article + 面包屑(首页 → 分类 → 本篇)。
const site = Astro.site ?? new URL('https://buffett.ayaseeri.com');
const url = absoluteUrl(site, canonicalPath(Astro.url.pathname));
const description = toExcerpt(article.body, 150);
const image = absoluteUrl(site, `/og/${ogKey(Astro.url.pathname)}.png`);
const catSlug = CATEGORY_SLUG[article.category];
const crumbs = [{ name: '首页', url: absoluteUrl(site, '/') }];
if (catSlug) crumbs.push({ name: article.category, url: absoluteUrl(site, `/categories/${catSlug}`) });
crumbs.push({ name: article.title, url });
const jsonLd = [
  articleLd({ url, title: article.title, description, keywords: article.keywords, section: article.category, image }),
  breadcrumbLd(crumbs),
];
---
<BaseLayout
  title={article.title}
  description={description}
  keywords={article.keywords}
  ogType="article"
  jsonLd={jsonLd}
>
  <nav class="views" style="margin-bottom:1rem;display:flex;gap:0.75rem;">
    <button data-view="read" class="view-btn">阅读</button>
    <button data-view="graph" class="view-btn">图谱</button>
    <button data-view="source" class="view-btn">来源</button>
  </nav>
  <article data-view-pane="read" data-pagefind-body>
    <h1>{article.title}</h1>
    <p style="color:var(--text-muted)">{article.category}</p>
    <Content />
  </article>
  <div data-view-pane="graph" hidden>
    <h2>{article.category} 局部关系</h2>
    <GraphView category={article.category} />
  </div>
  <div data-view-pane="source" hidden>
    <SourceMatrix slug={article.slug} />
  </div>
  <KeywordPanel slot="aside" keywords={article.keywords} related={article.related} sourceTypes={article.sourceTypes} />
  <Backlinks slot="aside" slug={article.slug} />
</BaseLayout>
<script>
  const btns = document.querySelectorAll('.view-btn');
  const panes = document.querySelectorAll('[data-view-pane]');
  btns.forEach((b) => b.addEventListener('click', () => {
    const v = b.getAttribute('data-view');
    panes.forEach((p) => (p.hidden = p.getAttribute('data-view-pane') !== v));
    // 图谱容器初始 hidden(display:none),Cytoscape 初始化时量到 0 尺寸;
    // 切到图谱时触发一次 window resize,让 autoResize 的 cy 重新量取并重绘。
    if (v === 'graph') window.dispatchEvent(new Event('resize'));
  }));
</script>
<style>
  /* 视图切换:可点按尺寸 + 小屏换行。 */
  .views { flex-wrap: wrap; }
  .view-btn {
    font: inherit; cursor: pointer; color: var(--green);
    background: var(--panel); border: 1px solid #e7e1d4; border-radius: 6px;
    padding: 0.5rem 0.9rem; min-height: 2.5rem;
  }
  .view-btn:hover { background: var(--green-soft); }
</style>
